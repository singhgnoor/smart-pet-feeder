# ==============================================================================
# PawPilot Web IoT Dashboard Environment Configuration
# ==============================================================================

# Device connection mode:
# - 'hardware': Connects to real ESP32-CAM REST API & SSE event stream via Vite dev proxy
# - 'mock': In-browser realistic IoT simulator (fallback for offline demo/testing)
VITE_DEVICE_MODE=hardware

# Target ESP32-CAM Network Configuration (Proxied by Vite during local development)
VITE_ESP32_HOST=192.168.1.100
VITE_ESP32_PORT=80

# Security API Key sent in 'X-API-Key' HTTP header for mutating endpoints:
# (/api/feed, /api/abort, /api/clear, /api/schedule, /api/tare, /api/calibrate, /api/config)
VITE_DEVICE_API_KEY=change-me
